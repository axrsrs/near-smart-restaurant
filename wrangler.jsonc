// Tetra (NEAR) — Cloudflare Workers · https://tetra.neardiji.com
// Yayın: npm run yayinla  → derler, dist/ klasörünü tek Worker dosyasına paketler, yükler.
{
  "name": "near-smart-restaurant",
  "main": "dist-worker/worker.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "routes": [{ "pattern": "tetra.neardiji.com", "custom_domain": true }],
  "preview_urls": false
}
